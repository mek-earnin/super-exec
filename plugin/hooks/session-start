#!/usr/bin/env bash
# SessionStart hook for super-exec plugin
#
# =============================================================================
# MARKER LIFECYCLE
# =============================================================================
#
# Markers live under .super-exec/ in the TARGET repo (the repo where super-exec
# is installed and where the /se-* skills run). That directory is gitignored.
#
# MARKER             WRITTEN BY                       CLEARED BY
# ─────────────────────────────────────────────────────────────────────────────
# .super-exec/active   A /se-* driver skill on its       se-pr on PR completion;
#                      session-activation step            se-exec on the no-PR exit
#                      (se-discuss, se-plan, se-exec,     (final review with
#                      se-pr-triage). se-plan adds        Auto-PR OFF and the user
#                      active_plan immediately after      declines the PR); se-pr-triage
#                      the plan file is written.          at the end of a triage round.
#                      Anchor: immediately after the plan file is written.
#                                                         SessionStart never deletes it.
#
# .super-exec/gate-open  se-exec — both the review-       se-exec, once the gate
#                        before-commit toggle AND the     resolves (human approves
#                        end-of-build final-review gate   the review).
#                        (NOT se-pr; se-pr no longer
#                        manages this marker).
#
# GUARD BEHAVIOUR (plugin/hooks/guard):
#   - Inert when .super-exec/active is absent, EXCEPT B1 (below).
#   - B1 (hard block): gate-open + git commit → DENY, context-agnostic
#     (ignores agent_id, ignores active). In practice gate-open only appears
#     inside an active session, so this is belt-and-suspenders.
#   - N2 (nudge): active + controller + git mutate → allow + context nudge to
#     use the repo's git/PR skill via a subagent.
#   - N1 (nudge): active + controller + build/test → allow + context nudge to
#     delegate heavy work to a subagent.
#   - N3 (nudge): active + write to a spec file (spec-*.md) under docs/specs/ OR
#     .super-exec/specs/ containing a fenced code block → allow + context nudge
#     that the spec is WHAT-only and code belongs in the plan. Fires for
#     controller AND subagents (code in a spec is wrong wherever written).
#     Cursor has no generic pre-file event, so N3 degrades to prose there (not
#     emitted).
#   - Subagents (agent_id present in CC payload) never receive N1/N2.
#   - On Cursor: N1/N2 degrade to prose (no nudge emitted); B1 runs natively.
#
# STALE MARKER ORIENTATION (NO FIXED NUMERIC VALUE):
#   Deciding whether .super-exec/active is stale is a MODEL-JUDGED heuristic.
#   The session-start hook surfaces the marker's mtime and any in-progress plan
#   context to the model via the orientation injection below. The model reads
#   that context and decides whether to ask the user about clearing it. The hook
#   NEVER auto-deletes the marker and NEVER uses a hardcoded numeric TTL.
#   This avoids false positives (a dev resumes after a long weekend) while
#   still letting the model surface "this looks stale — should I clear it?"
#   to the user.
#
# RESUME DETECT (this hook):
#   Read-only re: markers. Appended to orientation context only. Prefers
#   active_plan from .super-exec/active, then falls back to latest plan discovery.
#   Never writes, moves, or deletes any .super-exec/ marker.
#
# LOCAL-IGNORE (this hook):
#   The hook's ONE write: it ensures .super-exec/ is listed in the repo-local,
#   UNCOMMITTED .git/info/exclude (idempotent). This keeps the working dir out
#   of git WITHOUT touching the team-shared .gitignore — a local-only artifact
#   deserves a local-only ignore — and it runs every session (every entrypoint),
#   so it does not depend on se-discuss's branch gate having run. No marker is
#   written here.
# =============================================================================

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read the hook payload from stdin (JSON). Harnesses send it and close stdin;
# the `-t 0` guard avoids a blocking read on an interactive/manual run with no
# piped input.
hook_payload=""
if [ ! -t 0 ]; then
  hook_payload=$(cat 2>/dev/null || true)
fi

# Determine the target project directory. The payload is AUTHORITATIVE and is
# preferred over env vars:
#   - Claude Code's SessionStart payload carries `cwd`.
#   - Cursor's sessionStart payload carries `workspace_roots[]` (NO `cwd`) and
#     does NOT reliably export CURSOR_PROJECT_DIR to the hook process. An
#     env-only resolution therefore falls back to PWD — which is the PLUGIN
#     directory, not the user's repo — so the local-ignore write lands in the
#     wrong repository and the user's .super-exec/ is never ignored.
# Precedence: payload (cwd → workspace_roots[0]) → CLAUDE_PROJECT_DIR →
# CURSOR_PROJECT_DIR → PWD.
payload_dir=""
if [ -n "${hook_payload}" ] && command -v node >/dev/null 2>&1; then
  payload_dir=$(printf '%s' "${hook_payload}" | node -e "
    let raw='';
    process.stdin.on('data', d => raw += d);
    process.stdin.on('end', () => {
      try {
        const p = JSON.parse(raw);
        let dir = (typeof p.cwd === 'string' && p.cwd) ? p.cwd : '';
        if (!dir && Array.isArray(p.workspace_roots) && p.workspace_roots.length
            && typeof p.workspace_roots[0] === 'string') {
          dir = p.workspace_roots[0];
        }
        process.stdout.write(dir);
      } catch (e) { process.stdout.write(''); }
    });
  " 2>/dev/null || true)
fi

if [ -n "${payload_dir}" ]; then
  PROJECT_DIR="${payload_dir}"
elif [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
  PROJECT_DIR="${CLAUDE_PROJECT_DIR}"
elif [ -n "${CURSOR_PROJECT_DIR:-}" ]; then
  PROJECT_DIR="${CURSOR_PROJECT_DIR}"
else
  PROJECT_DIR="${PWD}"
fi

SUPER_EXEC_DIR="${PROJECT_DIR}/.super-exec"

# ---------------------------------------------------------------------------
# ENSURE LOCAL-ONLY IGNORE (the ONLY write this hook performs)
# ---------------------------------------------------------------------------
# Keep super-exec's local-only working dir (.super-exec/) out of git via the
# repo-local, UNCOMMITTED .git/info/exclude rather than the team-shared
# .gitignore. Runs every session, so it does not depend on se-discuss's branch
# gate. Idempotent: the pattern is appended only when absent.
ensure_local_ignore() {
  local exclude_rel exclude_file
  # git rev-parse resolves info/exclude correctly even for worktrees/submodules.
  exclude_rel=$(cd "${PROJECT_DIR}" 2>/dev/null && git rev-parse --git-path info/exclude 2>/dev/null) || return 0
  [ -n "${exclude_rel}" ] || return 0
  case "${exclude_rel}" in
    /*) exclude_file="${exclude_rel}" ;;
    *)  exclude_file="${PROJECT_DIR}/${exclude_rel}" ;;
  esac
  mkdir -p "$(dirname "${exclude_file}")" 2>/dev/null || return 0
  grep -qxF ".super-exec/" "${exclude_file}" 2>/dev/null || printf '%s\n' ".super-exec/" >> "${exclude_file}"
}
ensure_local_ignore || true

# Read using-super-exec orientation content
using_super_exec_content=$(cat "${PLUGIN_ROOT}/skills/using-super-exec/SKILL.md" 2>&1 || echo "Error reading using-super-exec skill")

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_super_exec_escaped=$(escape_for_json "$using_super_exec_content")

# ---------------------------------------------------------------------------
# CURSOR TRANSLATION INJECTION (Cursor only)
# ---------------------------------------------------------------------------
# super-exec skills are authored in Claude Code language. The one-way CC->Cursor
# translation lives in references/cursor-tools.md and is only SOFT-referenced
# from the skills ("see cursor-tools.md"), so on Cursor the model frequently
# never opens it — and then inherits the session model for every subagent
# (cheap git/lint/finder work ends up on the strong/expensive model). To
# GUARANTEE the translation is in context, inject the full file here when
# running under Cursor. CURSOR_PLUGIN_ROOT is the Cursor signal (the same gate
# the output branch below uses); on Claude Code this block is skipped because
# CC consumes the aliases natively.
cursor_translation_block=""
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  cursor_tools_content=$(cat "${PLUGIN_ROOT}/skills/using-super-exec/references/cursor-tools.md" 2>&1 || echo "Error reading cursor-tools.md")
  cursor_tools_escaped=$(escape_for_json "$cursor_tools_content")
  cursor_translation_block="\n\n<super-exec-cursor-translation>\n**You are running under Cursor.** super-exec skills are authored in Claude Code language; the full one-way CC->Cursor translation is injected below, so you do NOT need to open any file to apply it. Resolve EVERY CC primitive (tools, model tiers/aliases, AskUserQuestion, hook events, env vars) through it.\n\n**Subagent model rule (the common Cursor failure):** resolve each subagent's model through the **Model tiers** table below and set it EXPLICITLY on dispatch. NEVER omit it — omitting inherits the session model and silently defeats the tier system (cheap git/lint/finder work ends up on the strong model). Map by tier: cheap -> latest available non-fast GPT Luna, falling back to Composer or another non-fast cheap-tier model; mid -> latest `cursor-grok-*` high; strong -> strongest high-effort reasoning model. Then pick the matching slug from the dispatch tool's OWN allowlist. Do NOT hard-code a model name from memory — the allowlist is the source of truth and the slugs change often.\n\n${cursor_tools_escaped}\n</super-exec-cursor-translation>"
fi

# ---------------------------------------------------------------------------
# RESUME DETECT (read-only — NO writes to markers)
# ---------------------------------------------------------------------------
# Check for an active super-exec session and any in-progress plan directory.
# We surface the marker age and plan context so the model can judge whether
# the session is stale (no fixed TTL — see stale marker orientation above).
resume_note=""

if [ -f "${SUPER_EXEC_DIR}/active" ]; then
  # Get the marker's modification time for the model's staleness judgement.
  active_mtime=""
  if command -v stat >/dev/null 2>&1; then
    # macOS stat uses -f; GNU stat uses -c. Try both, fail silently.
    active_mtime=$(stat -f '%Sm' -t '%Y-%m-%d %H:%M:%S %Z' "${SUPER_EXEC_DIR}/active" 2>/dev/null \
      || stat -c '%y' "${SUPER_EXEC_DIR}/active" 2>/dev/null \
      || echo "unknown")
  fi

  plan_context=""
  plan_status=""
  invalid_plan_context=""

  set_plan_context_from_file() {
    local plan_file="$1"
    local source_note="$2"
    local feature_dir feature plan_dir plan_name plan_parent handoff_note line in_frontmatter parsed_status

    plan_dir=$(dirname "$plan_file")
    plan_name=$(basename "$plan_dir")
    # Feature dir differs by layout:
    #   v1: <root>/[<app>/]<feature>/plans/<plan-dir>/plan-<name>.md (skip plans/)
    #   v0: .super-exec/[<app>/]<feature>/<plan-dir>/plan.md
    plan_parent=$(dirname "$plan_dir")
    if [ "$(basename "$plan_parent")" = "plans" ]; then
      feature_dir=$(dirname "$plan_parent")
    else
      feature_dir="$plan_parent"
    fi
    feature=$(basename "$feature_dir")
    handoff_note=""
    if compgen -G "${plan_dir}/handoff-*.md" >/dev/null 2>&1 || [ -f "${plan_dir}/handoff.md" ]; then
      handoff_note=" (handoff present — mid-session handoff detected)"
    fi
    plan_context="Feature: ${feature} / Plan dir: ${plan_name} (${source_note})${handoff_note}"
    plan_status=""
    in_frontmatter="0"
    while IFS= read -r line; do
      if [ "$in_frontmatter" = "0" ]; then
        [ "$line" = "---" ] && in_frontmatter="1" || break
        continue
      fi
      [ "$line" = "---" ] && break
      case "$line" in
        status:*)
          parsed_status="${line#status:}"
          parsed_status="${parsed_status#"${parsed_status%%[![:space:]]*}"}"
          parsed_status="${parsed_status%"${parsed_status##*[![:space:]]}"}"
          parsed_status="${parsed_status%\"}"
          parsed_status="${parsed_status#\"}"
          parsed_status="${parsed_status%\'}"
          parsed_status="${parsed_status#\'}"
          plan_status="$parsed_status"
          break
          ;;
      esac
    done < "$plan_file"
  }

  # Prefer the concrete plan recorded in the active marker (a plan file path):
  #   active_plan: <root>/[<app>/]<feature>/plans/<YYYY-MM-DD>-<plan-name>/plan-<plan-name>.md
  # The marker remains the active-session signal for guards; active_plan adds the
  # concrete plan target for resume/execute sessions.
  trim_marker_value() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"
    printf '%s' "$value"
  }

  active_plan=""
  marker_mode=""
  marker_spec=""
  while IFS= read -r marker_line; do
    case "$marker_line" in
      active_plan:*)
        active_plan="$(trim_marker_value "${marker_line#active_plan:}")"
        ;;
      mode:*)
        marker_mode="$(trim_marker_value "${marker_line#mode:}")"
        ;;
      spec:*)
        marker_spec="$(trim_marker_value "${marker_line#spec:}")"
        ;;
    esac
  done < "${SUPER_EXEC_DIR}/active"

  if [ -n "$active_plan" ]; then
    case "$active_plan" in
      /*) resolved_plan="$active_plan" ;;
      *)  resolved_plan="${PROJECT_DIR}/${active_plan}" ;;
    esac
    if [ -d "$resolved_plan" ]; then
      # Marker names a directory — locate the plan file inside it.
      # v1: plan-<plan-name>.md; v0: plan.md.
      plan_in_dir=""
      for cand in "$resolved_plan"/plan-*.md "$resolved_plan/plan.md"; do
        [ -f "$cand" ] && { plan_in_dir="$cand"; break; }
      done
      resolved_plan="${plan_in_dir:-${resolved_plan}/plan.md}"
    fi
    if [ -f "$resolved_plan" ]; then
      set_plan_context_from_file "$resolved_plan" "active_plan marker"
    else
      invalid_plan_context="active_plan marker references ${active_plan}, but no plan file exists there"
    fi
  fi

  # Skip-plan has no plan file. Do not fall back to latest-plan discovery —
  # that would point resume at an unrelated stale plan.
  #
  # `mode: skip-plan` is the ONLY discriminator. The producers (se-discuss when
  # it routes into same-session /se-exec, and se-exec on skip-plan activation)
  # write it alongside `spec:`. Skip-plan is never INFERRED from "has spec: and
  # no active_plan" — a plan-phase marker legitimately carries spec: before the
  # plan file exists, and inferring there would strand it in skip-plan
  # orientation instead of letting it fall through to latest-plan discovery.
  skip_plan_context=""
  if [ -z "$plan_context" ] && [ -z "$invalid_plan_context" ] \
     && [ "$marker_mode" = "skip-plan" ]; then
    skip_plan_context="${marker_spec:-task spec (unwritten interview WHAT)}"
  fi

  # Fallback when the marker does not name a concrete plan: discover the most
  # recently modified plan file across BOTH roots and BOTH layouts.
  #   v1: <root>/[<app>/]<feature>/plans/<YYYY-MM-DD>-<plan-name>/plan-<plan-name>.md
  #   v0: .super-exec/[<app>/]<feature>/<plan-dir>/plan.md
  # (<root> = .super-exec/specs OR docs/specs.) Best-effort orientation only —
  # the active_plan marker above stays authoritative whenever it is present.
  # Skip-plan markers must not use this fallback.
  if [ -z "$plan_context" ] && [ -z "$invalid_plan_context" ] && [ -z "$skip_plan_context" ]; then
    discovery_roots=()
    [ -d "${SUPER_EXEC_DIR}" ] && discovery_roots+=("${SUPER_EXEC_DIR}")
    [ -d "${PROJECT_DIR}/docs/specs" ] && discovery_roots+=("${PROJECT_DIR}/docs/specs")
    if [ "${#discovery_roots[@]}" -gt 0 ]; then
      # `|| true`: under `set -euo pipefail`, `head -1` closing the pipe early
      # makes `ls` take SIGPIPE and `pipefail` propagate nonzero — without this
      # guard `set -e` would abort the ENTIRE hook (dropping ALL orientation)
      # once the plan-file list is large enough to overflow the pipe buffer.
      latest_plan_file=$(find "${discovery_roots[@]}" -mindepth 2 -type f \
        \( -name 'plan.md' -o -name 'plan-*.md' \) \
        -exec ls -t1 {} + 2>/dev/null | head -1 || true)
      if [ -n "$latest_plan_file" ]; then
        set_plan_context_from_file "$latest_plan_file" "latest plan discovery"
      fi
    fi
  fi

  if [ -n "$plan_context" ]; then
    resume_header="SUPER-EXEC SESSION IN PROGRESS"
    plan_label="In-progress plan"
    resume_instruction="You can resume this session with \`/se-exec\`."
    if [ "$plan_status" = "completed" ]; then
      resume_header="SUPER-EXEC SESSION ACTIVE (completed plan)"
      plan_label="Completed plan"
      resume_instruction="You can run \`/se-exec\` to let se-exec confirm completion or choose the next explicit action."
    fi
    resume_note="\n\n---\n**${resume_header}**\n\nA super-exec session is active (marker age: ${active_mtime:-unknown}).\n${plan_label}: ${plan_context}\n\n${resume_instruction} If this marker appears stale (the timestamp above is old relative to the current date), surface that to the user and ask whether to clear it — do NOT auto-delete the marker.\n---"
  elif [ -n "$invalid_plan_context" ]; then
    resume_note="\n\n---\n**SUPER-EXEC SESSION IN PROGRESS (active plan invalid)**\n\nA super-exec \`active\` marker exists (marker age: ${active_mtime:-unknown}). ${invalid_plan_context}. Surface this to the user; do NOT silently choose a different plan and do NOT auto-delete the marker.\n---"
  elif [ -n "$skip_plan_context" ]; then
    resume_note="\n\n---\n**SUPER-EXEC SESSION IN PROGRESS (skip-plan)**\n\nA super-exec skip-plan session is active (marker age: ${active_mtime:-unknown}).\nGoverning spec: ${skip_plan_context}\n\nYou can resume this session with \`/se-exec\`. Do NOT pick a plan from disk and do NOT auto-delete the marker.\n---"
  else
    resume_note="\n\n---\n**SUPER-EXEC SESSION IN PROGRESS (no in-progress plan found)**\n\nA super-exec \`active\` marker exists (marker age: ${active_mtime:-unknown}) but no in-progress plan file was found under \`.super-exec/\` or \`docs/specs/\`. This may indicate the session never advanced past discuss/plan, or the plan directory was cleaned up. If the marker looks stale, surface that to the user. Do NOT auto-delete the marker.\n---"
  fi
fi

session_context="<super-exec>\nYou have the super-exec workflow plugin loaded.\n\n**Below is the full content of your 'super-exec:using-super-exec' skill — your orientation to the workflow:**\n\n${using_super_exec_escaped}${resume_note}${cursor_translation_block}\n</super-exec>"

# Output context injection as JSON.
# Cursor hooks expect additional_context (snake_case).
# Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
# Copilot CLI (v1.0.11+) and others expect additionalContext (top-level, SDK standard).
# Claude Code reads BOTH additional_context and hookSpecificOutput without
# deduplication, so we must emit only the field the current platform consumes.
#
# Uses printf instead of heredoc to work around a bash 5.3+ heredoc hang.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT)
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  # Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  # Copilot CLI (sets COPILOT_CLI=1) or unknown platform — SDK standard format
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
